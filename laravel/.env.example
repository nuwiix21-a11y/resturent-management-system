APP_NAME="Street 160 Restaurant"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Database (MySQL via XAMPP) ──────────────────
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=restaurant_db
DB_USERNAME=root
DB_PASSWORD=

# ── Sanctum / Session ───────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,localhost:5500,127.0.0.1:5500
SESSION_DRIVER=file
SESSION_DOMAIN=localhost

# ── Cache / Queue ───────────────────────────────
BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_LIFETIME=120

# ── Mail (optional) ─────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@street160.lk"
MAIL_FROM_NAME="${APP_NAME}"
